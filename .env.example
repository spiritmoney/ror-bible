# Copy to .env for local development. Do not commit real secrets.

# Desktop (Electron) — absolute Hosting origin for /proxy and static fallbacks
REACT_APP_ELECTRON_HOSTING_ORIGIN=https://rhapsodybible.web.app

# Optional Cloud Functions base (Espees paths deferred in UI)
REACT_APP_ELECTRON_FUNCTIONS_ORIGIN=https://us-central1-kjv-strongs-reader.cloudfunctions.net

# Espees rewrite paths on Hosting (used when payment flows are enabled)
REACT_APP_ESPEES_CREATE_PRODUCT_PATH=/espees/create-product
REACT_APP_ESPEES_CONFIRM_PAYMENT_PATH=/espees/confirm-payment

# KingsChat — register the same URI in the KingsChat developer dashboard
REACT_APP_KINGSCHAT_REDIRECT_URL=rhapsody-bible://auth/callback

# Loopback fallback if KingsChat requires http:// (must match registered URI)
# REACT_APP_KINGSCHAT_REDIRECT_URL=http://127.0.0.1:47823/auth/callback

# Set automatically for electron web builds
# REACT_APP_IS_ELECTRON=true

# GitHub Releases auto-update (enable when publish URL is configured)
# ELECTRON_UPDATE_URL=
