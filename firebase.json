{
  "hosting": {
    "site": "rhapsodybible",
    "public": "build",
    "ignore": [
      "firebase.json",
      "**/.*",
      "/node_modules/"
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "**/*.{js,css}",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "**/favicon.ico",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
      }
    ],
    "rewrites": [
      {
        "source": "/espees/create-product",
        "function": "espeesCreateProduct"
      },
      {
        "source": "/espees/confirm-payment",
        "function": "espeesConfirmPayment"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  }
}