  "scripts": {
    "ci": "source-map-explorer 'build/static/js/*.js'",
    "react": "cross-env PORT=3400 craco start",
    "local": "npm run dev:payments",
    "server": "node src/server.js",
    "dev:payments": "concurrently \"npm run server\" \"npm run react\"",
    "build": "PUBLIC_URL=/ sh build.sh",
    "build-electron": "sh build.sh",
    "test": "craco test",
    "eject": "react-scripts eject",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:start": "npm run electron:compile && concurrently \"npm run react\" \"wait-on http://localhost:3400 && electron .\"",
    "electron:build:all": "yarn build-electron && electron-builder build --publish never -mwl"
  },
